# <Tool>: <what is themed: colors / font>. Its config (<path>) includes the generated file with
#   <include directive> ~/.theme/generated/<tool>
# Reload: <signal / command / the tool watches its config / only on restart>.

render() {
    local i
    {
        print "# Generated by \`theme\` from colors/$THEME_COLORS and fonts/$THEME_FONT. Do not edit."
        print "background $background"
        print "foreground $foreground"
        for i in {0..15}; do print "color$i ${(P)${:-color$i}}"; done
        [[ -n ${font_family-} ]] && print "font_family $font_family"
        return 0
    } >$GEN/TOOL
}

reload() {
    (( $+commands[TOOL] )) || return 0
    TOOL --reload 2>/dev/null # replace with the real reload command
    return 0
}
