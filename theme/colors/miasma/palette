# Miasma - https://github.com/xero/miasma.nvim
# base16: mapped by hand from colors/miasma.vim (syntax roles, base00/base05 from the terminal port).
# The author's ANSI palette is rotated (its "red" is brown), so base08 is its error color instead.
# base04 is the midpoint of base03 and base05: the theme has no dim foreground.
# ANSI + terminal: extras/miasma.ghostty.
name="Miasma"
variant=dark

# Neovim: xero/miasma.nvim (lua/plugins/ui/colorscheme.lua in ~/.config/nvim)
nvim_colorscheme=miasma

# base16 - https://github.com/tinted-theming/home/blob/main/styling.md
base00="#222222"   # bg
base01="#1c1c1c"   # cursorline, floats
base02="#43492a"   # dark olive
base03="#666666"   # comment
base04="#94948b"   # midpoint of 03 and 05
base05="#c2c2b0"   # fg
base06="#d7c483"   # sand (identifiers)
base07="#d7c483"
base08="#b36d43"   # error
base09="#bb7744"   # orange
base0A="#d7c483"   # sand
base0B="#5f875f"   # green
base0C="#c9a554"   # gold
base0D="#78824b"   # olive (functions)
base0E="#bb7744"   # accent
base0F="#685742"   # brown

# terminal
background="#222222"
foreground="#c2c2b0"
cursor="#c7c7c7"
selection_bg="#e4c47a"
selection_fg="#000000"
color0="#000000"
color1="#685742"
color2="#5f875f"
color3="#b36d43"
color4="#78824b"
color5="#bb7744"
color6="#c9a554"
color7="#d7c483"
color8="#666666"
color9="#685742"
color10="#5f875f"
color11="#b36d43"
color12="#78824b"
color13="#bb7744"
color14="#c9a554"
color15="#d7c483"
