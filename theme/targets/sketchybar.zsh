# SketchyBar (macOS): colors + font family. Its sketchybarrc (~/.dotfiles/sketchybar) sources the
# generated file with
#   source ~/.theme/generated/sketchybar
# and `sketchybar --reload` reruns sketchybarrc. The bar keeps its own font size.

argb() { print -r -- 0xff${1#\#} }

render() {
    {
        print "# Generated by \`theme\` from colors/$THEME_COLORS and fonts/$THEME_FONT. Do not edit."
        print "BAR=$(argb $base00)"
        print "TEXT=$(argb $base05)"
        print "DIM=$(argb $base04)"
        print "ACCENT=$(argb $base0E)"
        print "ON_ACCENT=$(argb $base00)"
        print "WARN=$(argb $base08)"
        [[ -n ${nerd_font_family-} ]] && print "FONT=${(qq)nerd_font_family}"
        return 0
    } >$GEN/sketchybar
}

reload() {
    (( $+commands[sketchybar] )) || return 0
    sketchybar --reload &>/dev/null # fails when the bar isn't running
    return 0
}
