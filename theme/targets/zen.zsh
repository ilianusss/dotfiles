# Zen Browser: the window background and the accent. Its profile's chrome/userChrome.css is a link to
# the generated file (zen/ and bin/dotfiles), which Zen reads at start. The palette's `zen_color`
# is the background; without one it is base0E mixed 20% into base00.
# Reload: none, Zen reads userChrome.css only at start.

# mix <fg> <bg> <percent of fg>
mix() {
    local fg=${1#\#} bg=${2#\#} pct=$3 out=# i
    for i in 1 3 5; do
        out+=$(printf %02x $(( (16#${fg[i,i+1]} * pct + 16#${bg[i,i+1]} * (100 - pct)) / 100 )))
    done
    print -r -- $out
}

render() {
    local color=${zen_color:-$(mix $base0E $base00 20)}
    {
        print "/* Generated by \`theme\` from colors/$THEME_COLORS. Do not edit. */"
        print ":root { --zen-primary-color: $base0E !important; }"
        print "#zen-browser-background, #zen-toolbar-background {"
        print "    --zen-main-browser-background: $color !important;"
        print "    --zen-main-browser-background-toolbar: $color !important;"
        print "}"
    } >$GEN/zen.css
}

reload() {
    return 0
}
