# Ghostty: colors + font. Ghostty's config includes the generated file with
#   config-file = ?~/.theme/generated/ghostty
# and re-reads its config on SIGUSR2 (every window; a window you zoomed keeps its size).

render() {
    local i
    {
        print "# Generated by \`theme\` from colors/$THEME_COLORS and fonts/$THEME_FONT. Do not edit."
        for i in {0..15}; do print "palette = $i=${(P)${:-color$i}}"; done
        print "background = $background"
        print "foreground = $foreground"
        print "cursor-color = $cursor"
        print "cursor-text = $cursor_text"
        print "selection-background = $selection_bg"
        print "selection-foreground = $selection_fg"
        if [[ -n ${font_family-} ]]; then
            print "font-family = \"\""
            print "font-family = \"$font_family\""
        fi
        [[ -n ${font_size-} ]] && print "font-size = $font_size"
        [[ -n ${font_features-} ]] && print "font-feature = $font_features"
        return 0
    } >$GEN/ghostty
}

reload() {
    # Found through ps: on macOS, pgrep/pkill don't see Ghostty's process
    local pids=($(ps -axo pid=,comm= | awk '$2 ~ /(^|\/)ghostty$/ {print $1}'))
    (( $#pids )) && kill -USR2 $pids 2>/dev/null
    return 0
}
