# superfile: colors. It has no include directive, so render() writes the whole theme file, which
# LINKS (platforms/<os>.zsh) links into its theme folder as theme.toml; its config.toml
# (~/.dotfiles/superfile) selects it with `theme = 'theme'`. The font is the terminal's.
# Reload: only on restart, superfile reads its theme at start.

render() {
    local syntax=monokai
    [[ $variant == light ]] && syntax=github
    {
        print "# Generated by \`theme\` from colors/$THEME_COLORS. Do not edit."
        print "code_syntax_highlight = \"$syntax\""
        print "full_screen_fg = \"$foreground\""
        print "full_screen_bg = \"$background\""
        print "gradient_color = [\"$base0D\", \"$base0E\"]"
        print "file_panel_fg = \"$foreground\""
        print "file_panel_bg = \"$background\""
        print "file_panel_border = \"$base03\""
        print "file_panel_border_active = \"$base0E\""
        print "file_panel_top_directory_icon = \"$base0B\""
        print "file_panel_top_path = \"$base0D\""
        print "file_panel_item_selected_fg = \"$base0D\""
        print "file_panel_item_selected_bg = \"$base02\""
        print "footer_fg = \"$foreground\""
        print "footer_bg = \"$background\""
        print "footer_border = \"$base03\""
        print "footer_border_active = \"$base0B\""
        print "sidebar_fg = \"$foreground\""
        print "sidebar_bg = \"$background\""
        print "sidebar_title = \"$base0C\""
        print "sidebar_border = \"$base03\""
        print "sidebar_border_active = \"$base0E\""
        print "sidebar_item_selected_fg = \"$base0D\""
        print "sidebar_item_selected_bg = \"$base02\""
        print "sidebar_divider = \"$base03\""
        print "modal_fg = \"$foreground\""
        print "modal_bg = \"$background\""
        print "modal_border_active = \"$base04\""
        print "modal_cancel_fg = \"$background\""
        print "modal_cancel_bg = \"$base08\""
        print "modal_confirm_fg = \"$background\""
        print "modal_confirm_bg = \"$base0B\""
        print "help_menu_hotkey = \"$base0C\""
        print "help_menu_title = \"$base09\""
        print "cursor = \"$cursor\""
        print "correct = \"$base0B\""
        print "error = \"$base08\""
        print "hint = \"$base0C\""
        print "cancel = \"$base08\""
        return 0
    } >$GEN/superfile.toml
}

reload() {
    return 0
}
