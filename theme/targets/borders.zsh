# JankyBorders (macOS): the border colors. Its bordersrc (~/.dotfiles/borders) sources the
# generated file with
#   source ~/.theme/generated/borders
# Reload: running `borders <options>` while borders runs updates the running one.

render() {
    {
        print "# Generated by \`theme\` from colors/$THEME_COLORS. Do not edit."
        print "colors=(active_color=0xff${base0D#\#} inactive_color=0xff${base02#\#})"
    } >$GEN/borders
}

reload() {
    # Only when it runs: started without one, borders would stay in the foreground
    ps -axo comm= | awk '$1 ~ /(^|\/)borders$/ {found = 1} END {exit !found}' || return 0
    local -a colors
    source $GEN/borders
    borders $colors 2>/dev/null
    return 0
}
