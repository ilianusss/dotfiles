{
    "profiles": [
        {
            "name": "Default profile",
            "selected": true,
            "virtual_hid_keyboard": {
                "keyboard_type_v2": "ansi"
            },
            "complex_modifications": {
                "rules": [
                    {
                        "description": "right command = ctrl-option, the AeroSpace key (aerospace/aerospace.toml); it is no longer command",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "right_command",
                                    "modifiers": {
                                        "optional": [
                                            "any"
                                        ]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "left_control",
                                        "modifiers": [
                                            "left_option"
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "description": "option + fn = switch between the French and U.S. layouts",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "fn",
                                    "modifiers": {
                                        "mandatory": [
                                            "option"
                                        ]
                                    }
                                },
                                "to": [
                                    {
                                        "select_input_source": {
                                            "input_source_id": "^com\\.apple\\.keylayout\\.US$"
                                        }
                                    }
                                ],
                                "conditions": [
                                    {
                                        "type": "input_source_if",
                                        "input_sources": [
                                            {
                                                "input_source_id": "^com\\.apple\\.keylayout\\.French$"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "fn",
                                    "modifiers": {
                                        "mandatory": [
                                            "option"
                                        ]
                                    }
                                },
                                "to": [
                                    {
                                        "select_input_source": {
                                            "input_source_id": "^com\\.apple\\.keylayout\\.French$"
                                        }
                                    }
                                ],
                                "conditions": [
                                    {
                                        "type": "input_source_unless",
                                        "input_sources": [
                                            {
                                                "input_source_id": "^com\\.apple\\.keylayout\\.French$"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "description": "fn alone does nothing (macOS would switch the layout): option + fn does that",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "fn",
                                    "modifiers": {
                                        "optional": [
                                            "any"
                                        ]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "fn",
                                        "lazy": true
                                    }
                                ],
                                "to_if_alone": [
                                    {
                                        "key_code": "vk_none"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        }
    ]
}
